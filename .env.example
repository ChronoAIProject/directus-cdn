# ============================================================================
# Directus self-hosted CDN — environment template.
# Copy to .env for local dev. In k8s, supply via Secrets/ConfigMap.
# ============================================================================

# --- Image version (pin in production) ---
DIRECTUS_VERSION=11

# --- Directus core ---
# Generate each with: openssl rand -hex 32
KEY=REPLACE_WITH_RANDOM_HEX
SECRET=REPLACE_WITH_RANDOM_HEX

# --- Server ---
PORT=8055
PUBLIC_URL=http://localhost:8055

# --- Bootstrap admin (used only on first boot — change in UI after) ---
ADMIN_EMAIL=admin@aelf.io
ADMIN_PASSWORD=changeme-on-first-login

# --- Database ---
# DB_HOST=database matches the docker-compose service name.
# In k8s, override DB_HOST/DB_PORT to point at your managed Postgres.
DB_CLIENT=pg
DB_HOST=database
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=changeme-postgres-password

# --- Storage ---
# 'local' for dev, 's3' in k8s/production. The label is arbitrary; Directus
# reads STORAGE_<LABEL>_* for each location listed here.
STORAGE_LOCATIONS=local

# Local (dev)
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=/directus/uploads

# S3 / Cloudflare R2 (fill via k8s Secrets in prod, leave blank locally)
# R2 endpoint format: https://<account-id>.r2.cloudflarestorage.com
STORAGE_S3_DRIVER=s3
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false

# --- CDN / caching ---
# Sets Cache-Control max-age on /assets/* responses (seconds, 30d default).
# Cloudflare honors this for edge caching.
ASSETS_CACHE_TTL=2592000
# Server-side response cache (separate from CDN edge cache)
CACHE_ENABLED=true
CACHE_TTL=5m

# --- CORS ---
CORS_ENABLED=true
# Set to your blog frontend's origin in prod, e.g. https://blog.aelf.io
CORS_ORIGIN=true

# --- Extensions ---
# Hot-reload custom extensions on file change (dev convenience)
EXTENSIONS_AUTO_RELOAD=true
